# Copy to .env.local and fill in. Never commit .env.local.

# Clothsy AI (server only, starts with clothsy_live_). Never prefix with NEXT_PUBLIC_.
CLOTHSY_API_KEY=

# Supabase (Project Settings > API Keys). Publishable key starts sb_publishable_, secret key starts sb_secret_ (server only).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Credit protection (server only)
TRYON_ENABLED=true
TRYON_USER_DAILY_CAP=3
TRYON_GLOBAL_CAP=10

# Dev-only mock, never in production. Leave unset.
# TRYON_MOCK=1
